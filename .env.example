# Copy to .env and fill in. EXPO_PUBLIC_* values are inlined into the app bundle, so this is for
# NON-SECRET config only. The Gemini API key is NOT here — it lives only in the Cloudflare Worker
# secret (see worker/README.md).

# QuickLog AI proxy URL (the deployed Cloudflare Worker). Empty/unset = AI off → on-device rule
# parser handles logging. Example:
EXPO_PUBLIC_QUICKLOG_ENDPOINT=https://overdrive-quicklog.YOUR-SUBDOMAIN.workers.dev
# Optional public, unauthenticated exercise catalog snapshot endpoint. Empty disables remote
# refresh; the app continues with its verified bundle and SQLite/seed fallbacks.
EXPO_PUBLIC_CATALOG_ENDPOINT=
