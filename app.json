{
  "expo": {
    "name": "OverDrive",
    "slug": "overdrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "overdrive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.overdrive"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "OVERDRIVE uses the microphone only to transcribe your spoken workout logs, on demand.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "OVERDRIVE uses your photo library only when you pick a photo for your Evolution avatar or a meal log.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "OVERDRIVE reads your workouts, energy, heart rate, and body metrics on your device to calculate your Combat Power score.",
          "NSHealthUpdateUsageDescription": "OVERDRIVE saves the strength workouts you log so they appear in Apple Health.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
